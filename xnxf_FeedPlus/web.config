<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Lock" stopProcessing="true">
          <match url=".+lock.*" />
          <action type="Redirect" url="{HTTP_HOST}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
